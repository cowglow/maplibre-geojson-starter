{
  "name": "maplibre-geojson-starter",
  "private": true,
  "version": "1.0.0",
  "description": "Typed GeoJSON factories for ADS-B, AIS, radio and HF data, with example, property-based and golden tests, plus a MapLibre + React demo.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:update": "vitest run -u"
  },
  "dependencies": {
    "@turf/turf": "^7.4.0",
    "maplibre-gl": "^6.13.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-map-gl": "^8.1.3"
  },
  "devDependencies": {
    "@fast-check/vitest": "^0.5.0",
    "@maplibre/maplibre-gl-style-spec": "^26.4.4",
    "@placemarkio/check-geojson": "^0.1.14",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.1.2",
    "fast-check": "^4.10.2",
    "typescript": "^7.0.2",
    "vite": "^8.0.0",
    "vitest": "^5.0.3"
  }
}
